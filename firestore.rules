rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace the placeholder with the UID shown in Firebase Authentication > Users.
    // Use the same internal Firebase account on the 2-3 test devices.
    match /sharedData/{document} {
      allow read, write: if request.auth != null
        && request.auth.uid == "REPLACE_WITH_INTERNAL_USER_UID";
    }
  }
}
